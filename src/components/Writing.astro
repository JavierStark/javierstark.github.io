---
import writing from '../data/writing.json';
import Icon from './Icon.astro';
import { fmtDate } from '../lib/format';
import { existsSync } from 'node:fs';

const cover = (name?: string | null) => (name && existsSync(`public/assets/${name}`) ? `/assets/${name}` : null);
---
{writing.length > 0 && (
  <section id="writing">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Writing</p>
        <h2>Articles</h2>
        <p>I'm writing my Bachelor's thesis in the open, as a series of technical articles on Canton Network.</p>
      </div>
      <div class="articles">
        {writing.map((w) => (
          <a class="card article reveal" href={w.url} target="_blank" rel="noopener">
            {cover(w.image)
              ? <img class="article__cover" src={cover(w.image)} alt={`Cover: ${w.title}`} width="1600" height="836" loading="lazy" />
              : <div class="article__cover article__cover--blank" aria-hidden="true"><Icon name="book" /></div>}
            <div class="article__body">
              <p class="muted small"><Icon name="book" /> {fmtDate(w.date)} · {w.venue}</p>
              <h3>{w.title}</h3>
              <p class="muted">{w.summary}</p>
              <span class="link">Read the article <Icon name="external" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .articles { display: grid; gap: 16px; }
  .article { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); overflow: hidden; transition: transform .25s ease, border-color .25s ease; }
  .article:hover { transform: translateY(-3px); border-color: var(--accent); }
  .article__cover { width: 100%; height: 100%; aspect-ratio: 1600 / 836; object-fit: cover; }
  .article__cover--blank { display: grid; place-items: center; font-size: 3rem; background: linear-gradient(135deg, #12162e, #1b2347); color: var(--accent-2); }
  .article__body { padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .article h3 { font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .small { font-size: 0.85rem; display: flex; gap: 6px; align-items: center; }
  .link { margin-top: auto; display: inline-flex; gap: 6px; align-items: center; }
  @media (max-width: 860px) {
    .article { grid-template-columns: 1fr; }
    .article__cover { height: auto; }
  }
</style>
