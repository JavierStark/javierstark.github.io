---
import { data, strings, type Lang } from '../lib/i18n';
import TechIcon from './TechIcon.astro';
import { skillIcon } from '../lib/icons';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = strings(lang);
const skills = data(lang, 'skills');

// Display groups over the database skill categories; core skills first within each group.
const groups: [string, string[]][] = [
  [s.skills.groups[0], ['language']],
  [s.skills.groups[1], ['framework', 'library']],
  [s.skills.groups[2], ['cloud', 'devops', 'platform']],
  [s.skills.groups[3], ['data', 'ml-ai']],
  [s.skills.groups[4], ['methodology']],
  [s.skills.groups[5], ['domain']],
  [s.skills.groups[6], ['communication', 'leadership']],
];
const byGroup = groups
  .map(([label, cats]) => [label, skills.filter((k: any) => cats.includes(k.category)).sort((a: any, b: any) => Number(b.core) - Number(a.core))] as const)
  .filter(([, list]) => list.length > 0);
---
<section id="skills">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{s.skills.eyebrow}</p>
      <h2>{s.skills.title}</h2>
      <p>{s.skills.lead}</p>
    </div>
    <div class="skills">
      {byGroup.map(([label, list]) => (
        <div class="card group reveal">
          <h3>{label}</h3>
          <div class="chips">{list.map((k: any) => <span class={`chip skill ${k.core ? 'core' : 'muted'}`}><TechIcon icon={skillIcon(k.name)} />{k.name}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .group { padding: 22px; }
  .group h3 { font-size: 1rem; margin-bottom: 12px; }
  .skill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; }
  .skill.core { border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
</style>
