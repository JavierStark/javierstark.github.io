---
import profile from '../data/profile.json';
import talks from '../data/talks.json';
import projects from '../data/projects.json';
import awards from '../data/awards.json';
import certifications from '../data/certifications.json';

// Every figure below is counted from the generated data, never typed by hand.
const stats = [
  [talks.length, 'talks, workshops & courses'],
  [projects.length, 'featured projects'],
  [awards.length, 'awards & distinctions'],
  [certifications.length, 'certifications'],
];
---
<section id="about">
  <div class="wrap about reveal">
    <div class="section-head">
      <p class="eyebrow">About</p>
      <h2>I build software, then teach it.</h2>
    </div>
    <div class="about__grid">
      <aside class="about__side">
        <img class="about__photo" src="/assets/about-portrait.jpg" alt={`Portrait of ${profile.full_name}`} width="800" height="800" loading="lazy" />
        <div class="card avail">
          <h3>Availability</h3>
          <ul>{profile.availability.map((a) => <li>{a}</li>)}</ul>
          <p class="muted langs">{profile.languages.map((l) => `${l.language} (${l.proficiency.replace('-', ' ')})`).join(' · ')}</p>
        </div>
      </aside>
      <div class="about__text">
        {profile.summary.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <dl class="stats">
      {stats.map(([n, label]) => <div class="card stat"><dt>{n}</dt><dd>{label}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; }
  .about__photo { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 18px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .avail { padding: 16px; margin-top: 12px; }
  .avail h3 { font-size: 0.95rem; margin-bottom: 8px; }
  .avail li { font-size: 0.85rem; padding-left: 14px; position: relative; }
  .avail li + li { margin-top: 4px; }
  .avail li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .langs { font-size: 0.8rem; margin-top: 10px; }
  .about__text { max-width: 68ch; }
  .about__text p { color: var(--text-muted); font-size: 1.05rem; }
  .about__text p + p { margin-top: 16px; }
  .about__text p:first-child { color: var(--text); font-size: 1.15rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 32px; }
  .stat { padding: 16px 18px; display: flex; align-items: baseline; gap: 12px; }
  .stat dt { font-family: var(--font-head); font-size: 1.8rem; font-weight: 700; color: var(--accent); line-height: 1; }
  .stat dd { color: var(--text-muted); font-size: 0.85rem; line-height: 1.3; }
  @media (max-width: 860px) {
    .about__grid { grid-template-columns: 1fr; gap: 24px; }
    .about__side { display: grid; grid-template-columns: 140px 1fr; gap: 16px; align-items: center; }
    .avail { margin-top: 0; }
    .stats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .about__side { grid-template-columns: 1fr; }
    .about__photo { max-width: 200px; }
  }
</style>
