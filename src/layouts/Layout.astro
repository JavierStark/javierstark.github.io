---
import '../styles/global.css';
import profile from '../data/profile.json';
import { firstSentence } from '../lib/format';

const title = `${profile.name} · ${profile.headline?.split('·')[0]?.trim() ?? 'Software Engineer'}`;
const description = firstSentence(profile.summary[0]);
const canonical = 'https://javiertorralbo.dev/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}assets/opensouthcode-2026-podium.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections on scroll; content stays visible without JS.
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // "More" disclosures: animated open/close everywhere; on mouse devices hovering a card
      // opens it after a short intent delay and clicking the toggle pins it open.
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setOpen = (details: HTMLDetailsElement, open: boolean) => {
        const body = details.querySelector<HTMLElement>('.more__body');
        if (!body || reduceMotion) { details.open = open; return; }
        body.getAnimations().forEach((a) => a.cancel());
        if (open) {
          details.open = true;
          const h = body.scrollHeight;
          body.animate(
            [{ height: '0px', opacity: 0, transform: 'translateY(-6px)' }, { height: `${h}px`, opacity: 1, transform: 'none' }],
            { duration: 380, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
          );
        } else if (details.open) {
          const h = body.scrollHeight;
          const anim = body.animate(
            [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
            { duration: 260, easing: 'cubic-bezier(0.4, 0, 0.6, 1)' },
          );
          anim.onfinish = () => { details.open = false; };
        }
      };
      const hoverMode = matchMedia('(hover: hover) and (pointer: fine)').matches;
      document.querySelectorAll<HTMLDetailsElement>('details.more').forEach((details) => {
        const summary = details.querySelector('summary');
        const card = details.closest('.card');
        if (!summary) return;
        let pinned = false;
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          if (hoverMode && details.open && !pinned) { pinned = true; return; }  // opened by hover: click keeps it open
          pinned = !details.open;
          setOpen(details, pinned);
        });
        if (!hoverMode || !card) return;
        let enter: number | undefined;
        let leave: number | undefined;
        card.addEventListener('mouseenter', () => {
          window.clearTimeout(leave);
          enter = window.setTimeout(() => { if (!details.open) setOpen(details, true); }, 220);
        });
        card.addEventListener('mouseleave', () => {
          window.clearTimeout(enter);
          leave = window.setTimeout(() => { if (!pinned) setOpen(details, false); }, 180);
        });
      });
    </script>
  </body>
</html>
