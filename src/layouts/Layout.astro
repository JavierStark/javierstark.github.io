---
import '../styles/global.css';
import profile from '../data/profile.json';
import { firstSentence } from '../lib/format';

const title = `${profile.name} · ${profile.headline?.split('·')[0]?.trim() ?? 'Software Engineer'}`;
const description = firstSentence(profile.summary[0]);
const canonical = 'https://javiertorralbo.dev/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}assets/opensouthcode-2026-podium.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections on scroll; content stays visible without JS.
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // "More" disclosures: animated open/close everywhere; on mouse devices hovering a card
      // opens it after a short intent delay and clicking the toggle pins it open.
      // Always animated (owner preference). With reduced motion the panel still eases open, but without
      // the slide, so it is a calm height + fade transition rather than movement.
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setOpen = (details: HTMLDetailsElement, open: boolean) => {
        const body = details.querySelector<HTMLElement>('.more__body');
        if (!body || document.hidden) { details.open = open; return; }  // hidden tabs freeze animation clocks
        body.getAnimations().forEach((a) => a.cancel());
        if (open) {
          details.open = true;
          const h = body.scrollHeight;
          body.animate(
            reduceMotion
              ? [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }]
              : [{ height: '0px', opacity: 0, transform: 'translateY(-6px)' }, { height: `${h}px`, opacity: 1, transform: 'none' }],
            { duration: 380, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
          );
        } else if (details.open) {
          const h = body.scrollHeight;
          const anim = body.animate(
            [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
            { duration: 260, easing: 'cubic-bezier(0.4, 0, 0.6, 1)' },
          );
          anim.onfinish = () => { details.open = false; };
        }
      };
      // Cards sharing a row in a multi-column grid (Projects, Speaking) open and close together so
      // the row stays balanced. Single-column layouts and full-width cards act alone.
      const rowOf = (details: HTMLDetailsElement): HTMLDetailsElement[] => {
        const card = details.closest<HTMLElement>('.card');
        const grid = card?.parentElement;
        if (!card || !grid) return [details];
        const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
        if (cols < 2) return [details];
        return [...grid.children]
          .filter((c): c is HTMLElement => c instanceof HTMLElement && c.classList.contains('card') && c.offsetTop === card.offsetTop)
          .map((c) => c.querySelector<HTMLDetailsElement>('details.more'))
          .filter((d): d is HTMLDetailsElement => !!d);
      };
      const pinned = new WeakSet<HTMLDetailsElement>();
      const setRow = (row: HTMLDetailsElement[], open: boolean) => row.forEach((d) => {
        if (open && !d.open) setOpen(d, true);
        if (!open && d.open) setOpen(d, false);
      });
      const hoverMode = matchMedia('(hover: hover) and (pointer: fine)').matches;
      let enterTimer: number | undefined;
      let leaveTimer: number | undefined;
      let hoverRow: HTMLDetailsElement[] = [];
      const closeIfUnpinned = (row: HTMLDetailsElement[]) => { if (!row.some((d) => pinned.has(d))) setRow(row, false); };

      document.querySelectorAll<HTMLDetailsElement>('details.more').forEach((details) => {
        const summary = details.querySelector('summary');
        const card = details.closest('.card');
        if (!summary) return;
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          const row = rowOf(details);
          if (hoverMode && details.open && !pinned.has(details)) {   // opened by hover: click keeps the row open
            row.forEach((d) => pinned.add(d));
            return;
          }
          const next = !details.open;
          row.forEach((d) => (next ? pinned.add(d) : pinned.delete(d)));
          setRow(row, next);
        });
        if (!hoverMode || !card) return;
        card.addEventListener('mouseenter', () => {
          window.clearTimeout(leaveTimer);
          const row = rowOf(details);
          if (hoverRow.length && !hoverRow.includes(details)) closeIfUnpinned(hoverRow);  // moved to another row
          hoverRow = row;
          window.clearTimeout(enterTimer);
          enterTimer = window.setTimeout(() => setRow(row, true), 220);
        });
        card.addEventListener('mouseleave', () => {
          window.clearTimeout(enterTimer);
          const row = rowOf(details);
          leaveTimer = window.setTimeout(() => { closeIfUnpinned(row); if (hoverRow === row) hoverRow = []; }, 180);
        });
      });
    </script>
  </body>
</html>
