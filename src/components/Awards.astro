---
import { data, strings, type Lang } from '../lib/i18n';
import { fmtDate, year } from '../lib/format';

import { existsSync } from 'node:fs';
import TechIcon from './TechIcon.astro';
import { issuerIcon } from '../lib/icons';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = strings(lang);
const awards = data(lang, 'awards');
const education = data(lang, 'education');
const certifications = data(lang, 'certifications');

const today = new Date().toISOString().slice(0, 7);
const featured = awards.find((a: any) => a.image && existsSync(`public/assets/${a.image}`));
const eduYears = (e: { start?: string | null; end?: string | null }) =>
  e.end && e.end > today ? `${year(e.start)} – ${s.expected} ${fmtDate(e.end, lang)}` : `${year(e.start)} – ${year(e.end)}`;
---
<section id="awards">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{s.awards.eyebrow}</p>
      <h2>{s.awards.title}</h2>
    </div>
    <div class="grid">
      <div class="card block reveal awards">
        {featured && (
          <figure class="award__photo">
            <img src={`/assets/${featured.image}`} alt={featured.title} loading="lazy" />
            <figcaption class="muted">{featured.title}</figcaption>
          </figure>
        )}
        <h3>{s.awards.awards}</h3>
        <ul class="list">
          {awards.map((a: any) => <li><span class="yr">{year(a.date)}</span><span>{a.title}<br /><small class="muted">{a.venue}</small></span></li>)}
        </ul>
      </div>
      <div class="col">
        {education.map((e: any) => (
          <div class="card block reveal">
            <h3>{s.awards.education}</h3>
            <p class="edu__deg">{[e.degree, e.field].filter(Boolean).join(s.awards.degreeJoin)}</p>
            <p class="muted">{e.institution} · {eduYears(e)}</p>
            <ul class="edu__hl">{(e.highlights ?? []).map((h: string) => <li>{h.replace(/\s*(Source|Fuente):.*$/, '')}</li>)}</ul>
          </div>
        ))}
        <div class="card block reveal">
          <h3>{s.awards.certifications}</h3>
          <ul class="list">
            {certifications.map((c: any) => <li class="cert"><TechIcon icon={issuerIcon(c.issuer)} size="md" /><span>{c.name}<br /><small class="muted">{c.issuer} · {year(c.date)}</small></span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .col { display: grid; gap: 16px; }
  .block { padding: 24px; }
  .awards { overflow: hidden; }
  .award__photo { margin: -24px -24px 20px; }
  .award__photo img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 35%; }
  .award__photo figcaption { font-size: 0.8rem; padding: 8px 24px 0; }
  .block h3 { font-size: 1.1rem; margin-bottom: 14px; }
  .list { display: grid; gap: 12px; }
  .list li { display: grid; grid-template-columns: 52px 1fr; gap: 10px; font-size: 0.93rem; }
  .cert { grid-template-columns: 34px 1fr !important; align-items: center; }
  .yr { font-family: var(--font-head); font-weight: 700; color: var(--accent); }
  .edu__deg { font-weight: 600; }
  .edu__hl { margin-top: 10px; display: grid; gap: 6px; }
  .edu__hl li { font-size: 0.9rem; padding-left: 18px; position: relative; }
  .edu__hl li::before { content: '▹'; position: absolute; left: 0; color: var(--accent); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
