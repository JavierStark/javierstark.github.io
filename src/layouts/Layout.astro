---
import '../styles/global.css';
import profile from '../data/profile.json';
import { firstSentence } from '../lib/format';

const title = `${profile.name} · ${profile.headline?.split('·')[0]?.trim() ?? 'Software Engineer'}`;
const description = firstSentence(profile.summary[0]);
const canonical = 'https://javiertorralbo.dev/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}assets/opensouthcode-2026-podium.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections on scroll; content stays visible without JS.
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // On mouse devices, hovering a card opens its "more" disclosure; clicking the toggle pins it.
      // Touch devices keep native tap-to-open (no hover there).
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll('.card').forEach((card) => {
          const details = card.querySelector('details.more');
          const summary = details?.querySelector('summary');
          if (!details || !summary) return;
          let timer: number | undefined;
          let pinned = false;
          card.addEventListener('mouseenter', () => { timer = window.setTimeout(() => { details.open = true; }, 120); });
          card.addEventListener('mouseleave', () => { window.clearTimeout(timer); if (!pinned) details.open = false; });
          summary.addEventListener('click', (e) => {
            if (details.open && !pinned) { e.preventDefault(); pinned = true; }  // opened by hover: click keeps it open
            else { pinned = !details.open; }                                   // otherwise behave as a normal toggle
          });
        });
      }
    </script>
  </body>
</html>
