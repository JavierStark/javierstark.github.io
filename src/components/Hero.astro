---
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import talks from '../data/talks.json';
import writing from '../data/writing.json';
import Icon from './Icon.astro';
import { firstSentence, linkUrl } from '../lib/format';

const current = experience.filter((r) => r.current).slice(0, 3);
const heroTalk = talks.find((t) => t.id === 'pub-2026-opensouthcode-aspire');
const latest = writing[0];
---
<section id="top" class="hero">
  <div class="wrap hero__grid">
    <div class="hero__text reveal">
      <p class="hero__status"><span class="status__item"><span class="dot"></span> Open to opportunities</span><span class="status__item"><Icon name="pin" /> {profile.location} · remote worldwide</span></p>
      <h1>{profile.name}</h1>
      <p class="hero__headline">{profile.headline}</p>
      <p class="hero__lead">{firstSentence(profile.summary[0])}</p>
      <ul class="hero__now">
        {current.map((r) => <li><strong>{r.title}</strong> <span class="muted">· {r.organization}</span></li>)}
      </ul>
      {latest && <a class="hero__article" href="#writing"><span class="chip">New article</span> {latest.title} →</a>}
      <div class="hero__cta">
        <a class="btn primary" href="#contact"><Icon name="mail" /> Get in touch</a>
        {profile.links.linkedin && <a class="btn" href={linkUrl(profile.links.linkedin)} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>}
        {profile.links.github && <a class="btn" href={linkUrl(profile.links.github)} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>}
      </div>
    </div>
    <figure class="hero__photo reveal">
      <img src="/assets/opensouthcode-2026-hero.jpg" alt={`${profile.name} speaking at OpenSouthCode 2026`} width="600" height="750" fetchpriority="high" />
      {heroTalk && <figcaption>Speaking at {heroTalk.venue}</figcaption>}
    </figure>
  </div>
</section>

<style>
  .hero { padding-top: 72px; }
  .hero__grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: center; }
  .hero__status { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.85rem; color: var(--text-muted); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; background: var(--bg-card); }
  .status__item { display: inline-flex; align-items: center; gap: 8px; }
  .status__item + .status__item { padding-left: 10px; border-left: 1px solid var(--line); }
  @media (max-width: 480px) { .status__item + .status__item { padding-left: 0; border-left: 0; } }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 4px rgba(61, 220, 132, 0.18); }
  h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); margin-top: 22px; }
  .hero__headline { font-family: var(--font-head); font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--accent); margin-top: 10px; }
  .hero__lead { font-size: 1.1rem; color: var(--text-muted); margin-top: 18px; max-width: 54ch; }
  .hero__now { margin-top: 18px; display: grid; gap: 4px; font-size: 0.95rem; }
  .hero__now li::before { content: '▹ '; color: var(--accent); }
  .hero__article { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 20px; font-size: 0.92rem; font-weight: 500; }
  .hero__article:hover { color: var(--accent); }
  .hero__photo figcaption { margin-top: 8px; text-align: right; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__photo img { width: 100%; max-height: 560px; border-radius: 22px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border: 1px solid var(--line); box-shadow: var(--shadow); }
  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .hero__photo { order: -1; max-width: 360px; }
    .hero__photo img { aspect-ratio: 1 / 1; max-height: 300px; object-position: 40% 20%; }
  }
</style>
