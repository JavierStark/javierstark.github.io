---
// Single-page portfolio, rendered once per language (/ and /es/). All career content comes from
// src/data/*.json (English) and src/data/es/*.json (Spanish), generated by JavierDB
// (`python career.py sync`). Edit facts there, not in these components.
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Writing from './Writing.astro';
import Speaking from './Speaking.astro';
import Projects from './Projects.astro';
import Awards from './Awards.astro';
import Skills from './Skills.astro';
import Contact from './Contact.astro';
import type { Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
---

<Layout lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Experience lang={lang} />
    <Writing lang={lang} />
    <Speaking lang={lang} />
    <Projects lang={lang} />
    <Awards lang={lang} />
    <Skills lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>
