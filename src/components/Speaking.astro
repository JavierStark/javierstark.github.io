---
import { data, strings, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import { fmtDate } from '../lib/format';
import { existsSync } from 'node:fs';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = strings(lang);
const talks = data(lang, 'talks');
const label: Record<string, string> = { talk: s.speaking.talk, course: s.speaking.course };
const aboutLabel: Record<string, string> = { talk: s.speaking.aboutTalk, course: s.speaking.aboutCourse };
// Only render photos that exist in public/assets (no broken images if a file is missing).
const photo = (name?: string | null) => (name && existsSync(`public/assets/${name}`) ? `/assets/${name}` : null);
// Talks with photos first; within each group, newest first (data is already date-sorted).
const ordered = [...talks.filter((t: any) => photo(t.image)), ...talks.filter((t: any) => !photo(t.image))];
---
<section id="speaking">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{s.speaking.eyebrow}</p>
      <h2>{s.speaking.title}</h2>
      <p>{s.speaking.lead}</p>
    </div>
    <div class="talks">
      {ordered.map((t: any) => (
        <article class={`card talk reveal ${photo(t.image) ? 'talk--photo' : ''}`}>
          {photo(t.image) && <img class="talk__img" src={photo(t.image)} alt={`${t.title}, ${t.venue}`} loading="lazy" />}
          <div class="talk__body">
            <div class="talk__top">
              <span class="chip"><Icon name="mic" /> {label[t.type] ?? s.speaking.talk}</span>
              <span class="muted small">{fmtDate(t.date, lang)}</span>
            </div>
            <h3>{t.title}</h3>
            <p class="talk__venue">{t.venue}</p>
            {t.audience && <p class="talk__aud">{t.audience}</p>}
            {t.url && <a class="link small post" href={t.url} target="_blank" rel="noopener">{s.speaking.readPost} <Icon name="external" /></a>}
            {t.summary && (
              <details class="more">
                <summary>{aboutLabel[t.type] ?? s.speaking.aboutTalk}</summary>
                <p class="muted small more__body">{t.summary}</p>
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .talks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .talk { display: flex; flex-direction: column; overflow: hidden; }
  .talk__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .talk__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .talk__top { display: flex; justify-content: space-between; align-items: center; }
  .talk h3 { font-size: 1.08rem; }
  .talk__venue { font-size: 0.9rem; color: var(--accent); font-weight: 500; }
  .talk__aud { font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; }
  .small { font-size: 0.86rem; }
  .post { margin-top: 4px; display: inline-flex; gap: 6px; align-items: center; }
  .chip :global(svg) { vertical-align: -2px; }
  @media (max-width: 760px) { .talks { grid-template-columns: 1fr; } }
</style>
