---
import '../styles/global.css';
import { data, strings, type Lang } from '../lib/i18n';
import { ui } from '../i18n/ui';
import { linkUrl } from '../lib/format';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = strings(lang);
const profile = data(lang, 'profile');
const experience = data(lang, 'experience');
const education = data(lang, 'education');
const skills = data(lang, 'skills');

const site = 'https://javiertorralbo.dev/';
const pageUrl = `${site.replace(/\/$/, '')}${s.home}`;
const role = profile.headline?.split('·')[0]?.trim() ?? 'Software Engineer';
const title = `${profile.name} · ${role}`;
// ~155 chars: what LinkedIn, Google and Slack show under the title.
const clip = (s: string, n = 155) => (s.length <= n ? s : `${s.slice(0, s.lastIndexOf(' ', n - 1))}…`);
const description = clip(profile.summary[0] ?? '');
const ogImage = `${site}og-image.png`;
const ogAlt = `${profile.name}, ${profile.headline}`;
// schema.org Person: helps search engines connect the site with LinkedIn and GitHub.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.full_name,
  alternateName: profile.name,
  url: pageUrl,
  inLanguage: lang,
  image: `${site}assets/about-portrait.jpg`,
  description: profile.headline,
  address: { '@type': 'PostalAddress', addressLocality: 'Málaga', addressCountry: 'ES' },
  sameAs: Object.entries(profile.links).filter(([k]) => k !== 'website').map(([, v]) => linkUrl(v as string)),
  worksFor: experience.filter((r: any) => r.current && r.employment_type !== 'volunteer').map((r: any) => ({ '@type': 'Organization', name: r.organization })),
  alumniOf: education.map((e: any) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  knowsAbout: skills.filter((k: any) => k.core).map((k: any) => k.name),
};
---

<!DOCTYPE html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.full_name} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={`${site}`} />
    <link rel="alternate" hreflang="es" href={`${site}es/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0f1020" />
    <!-- Link previews (LinkedIn, WhatsApp, Slack, Discord, Facebook) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={s.locale} />
    <meta property="og:locale:alternate" content={lang === 'es' ? ui.en.locale : ui.es.locale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="profile:first_name" content={profile.full_name.split(' ')[0]} />
    <meta property="profile:last_name" content={profile.full_name.split(' ').slice(1).join(' ')} />
    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <!-- Visitors who chose Spanish before land on /es/ when they open the English root. -->
    <script is:inline define:vars={{ isRoot: lang === 'en' }}>
      try {
        if (isRoot && localStorage.getItem('lang') === 'es') location.replace('/es/' + location.hash);
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections on scroll; content stays visible without JS.
      document.documentElement.classList.add('js');

      // Remember the language the visitor picks with the switcher.
      document.querySelector<HTMLAnchorElement>('.nav__lang')?.addEventListener('click', (e) => {
        try { localStorage.setItem('lang', (e.currentTarget as HTMLElement).dataset.lang ?? 'en'); } catch {}
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // "More" disclosures open on click only, always animated (owner preference). With reduced motion the panel still eases open, but without
      // the slide, so it is a calm height + fade transition rather than movement.
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setOpen = (details: HTMLDetailsElement, open: boolean) => {
        const body = details.querySelector<HTMLElement>('.more__body');
        if (!body || document.hidden) { details.open = open; return; }  // hidden tabs freeze animation clocks
        body.getAnimations().forEach((a) => a.cancel());
        if (open) {
          details.open = true;
          const h = body.scrollHeight;
          body.animate(
            reduceMotion
              ? [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }]
              : [{ height: '0px', opacity: 0, transform: 'translateY(-6px)' }, { height: `${h}px`, opacity: 1, transform: 'none' }],
            { duration: 380, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
          );
        } else if (details.open) {
          const h = body.scrollHeight;
          const anim = body.animate(
            [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
            { duration: 260, easing: 'cubic-bezier(0.4, 0, 0.6, 1)' },
          );
          anim.onfinish = () => { details.open = false; };
        }
      };
      // Cards sharing a row in a multi-column grid (Projects, Speaking) open and close together so
      // the row stays balanced. Single-column layouts and full-width cards act alone.
      const rowOf = (details: HTMLDetailsElement): HTMLDetailsElement[] => {
        const card = details.closest<HTMLElement>('.card');
        const grid = card?.parentElement;
        if (!card || !grid) return [details];
        const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
        if (cols < 2) return [details];
        return [...grid.children]
          .filter((c): c is HTMLElement => c instanceof HTMLElement && c.classList.contains('card') && c.offsetTop === card.offsetTop)
          .map((c) => c.querySelector<HTMLDetailsElement>('details.more'))
          .filter((d): d is HTMLDetailsElement => !!d);
      };
      const setRow = (row: HTMLDetailsElement[], open: boolean) => row.forEach((d) => {
        if (open && !d.open) setOpen(d, true);
        if (!open && d.open) setOpen(d, false);
      });
      document.querySelectorAll<HTMLDetailsElement>('details.more').forEach((details) => {
        const summary = details.querySelector('summary');
        if (!summary) return;
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          setRow(rowOf(details), !details.open);
        });
      });
    </script>
  </body>
</html>
